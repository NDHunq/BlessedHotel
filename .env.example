# Sao chép thành .env.local (máy dev) hoặc .env (server) rồi điền giá trị. KHÔNG commit file có giá trị thật.

# Domain thật của website (canonical, hreflang, link trong bộ chấm SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL. Máy dev: database trong docker-compose.yml
DATABASE_URL=postgres://blessed:blessed_dev@127.0.0.1:5432/blessed

# Tài khoản quản trị (1 người). Tạo mã băm: npm run hash-password  (nhập mật khẩu khi được hỏi)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Chuỗi ngẫu nhiên >= 32 ký tự để ký cookie đăng nhập. Tạo: openssl rand -base64 48
SESSION_SECRET=

# Lưu ảnh tải lên: "local" (thư mục UPLOAD_DIR, phục vụ qua /media/...) hoặc "r2" (Cloudflare R2)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# Khi STORAGE_DRIVER=r2:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Tên miền công khai của bucket, VD https://media.blessedhotelphuquoc.com (cũng cần cho next/image)
R2_PUBLIC_URL=
